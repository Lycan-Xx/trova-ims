# Better Auth Configuration
# ==========================

# REQUIRED: Set the production URL for your app
# This is used as the base URL for auth callbacks and cookies
BETTER_AUTH_URL=https://trova-ims.vercel.app

# OPTIONAL: Add additional trusted origins (comma-separated)
# These origins will be allowed to make authentication requests
# Useful for multiple domains, subdomains, or preview URLs
# Example: https://app.example.com,https://staging.example.com,https://preview-*.vercel.app
TRUSTED_ORIGINS=https://vm-design-system-foundation-1t.vusercontent.net

# Aurora Database Configuration
# ==============================

# AWS Aurora PostgreSQL IAM credentials
# These are set automatically by Vercel when the Aurora integration is connected
PGHOST=your-aurora-host.rds.amazonaws.com
PGUSER=postgres
PGDATABASE=trova_db
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::YOUR- ACCOUNT-ID:role/YOUR-ROLE
AWS_ACCOUNT_ID=YOUR-ACCOUNT-ID

# Better Auth Secret
# ==================
# Generate a secure random value: openssl rand -base64 32
# This is used to sign session tokens
BETTER_AUTH_SECRET=your-secret-key-here

# Migration Secret
# ================
# Optional secret for running database migrations via /api/migrate
# If set, migrations can only be run by providing ?secret=YOUR_SECRET
MIGRATION_SECRET=your-migration-secret-here
