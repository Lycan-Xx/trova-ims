{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trova IMS",
  "identifier": "com.lycanforge.trova",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "node scripts/tauri-prebuild.mjs",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trova IMS",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next/standalone": "standalone"
    },
    "windows": {
      "minimumWebview2Version": "2.0.0",
      "wix": {
        "upgradeCode": "7e3f8d12-4a1c-4b9e-8c2f-1d5a6e7b9c0d"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
